{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      // chlive's TS client, copied in (chlive-client/: its src/, and wasm/ from chlive's
      // `chlive-wasm`) by the dev shell's `web` and `web-check`, and by nix/packages/web.nix
      "@chlive/client": ["./chlive-client/src/index.ts"],
      "@chlive/client/react": ["./chlive-client/src/react.ts"]
    }
  },
  "include": ["src", "build.ts", "wasm-url.ts"]
}
